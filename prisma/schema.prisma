// Database schema for the invite-gated coaching marketplace.
// Apply changes to the database with: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL should be your provider's POOLED connection string (Neon:
// the "-pooler" host; Supabase: port 6543 with ?pgbouncer=true). On
// Vercel every request can spin up a new function instance with its own
// connections, and a direct URL runs out of connections under load.
// DIRECT_URL is the normal non-pooled string, used only by migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum InviteStatus {
  PENDING
  REDEEMED
  EXPIRED
  REVOKED
}

// Mentor visibility. PAUSED mentors are hidden from search until their
// return date (pausedUntil) passes, or until they unpause. REMOVED mentors
// are hidden entirely. A student REMOVED by an admin can't log in.
enum ProfileStatus {
  ACTIVE
  PAUSED
  REMOVED
}

enum CallStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING_PAYMENT
  IN_ESCROW
  COMPLETED
  RELEASED
  REFUNDED
  CANCELLED
}

// A simple fixed list rather than free text, so filtering on the coaches
// page actually works reliably (free-text categories would fragment into
// a dozen near-duplicate spellings). Add more values here if you need a
// category this list doesn't cover yet - Prisma migrations handle enum
// changes fine.
// Mentor applications from the public /become-a-mentor/apply form.
enum ApplicationStatus {
  PENDING
  INVITED
  DECLINED
}

enum GigCategory {
  ESSAY_REVIEW
  MOCK_INTERVIEW
  APPLICATION_STRATEGY
  TUTORING
  OTHER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String? // set automatically by Google sign-in; separate from photoUrl below
  passwordHash  String? // optional now - a Google-only account has no password on our side
  role          Role      @default(BUYER)
  name          String
  createdAt     DateTime  @default(now())

  // Seller-only profile fields. Null for buyers/admins.
  credential      String?
  bio             String?
  photoUrl        String?
  stripeAccountId String? // Stripe Connect account id, once onboarded

  // Login rate limiting - tracks repeated failed password attempts so a
  // brute-force guessing attack gets locked out rather than allowed to
  // keep trying indefinitely. See the authorize() function in lib/auth.ts.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Set whenever the password is reset or changed. Any login session
  // started before this moment is ended within ~5 minutes (see the jwt
  // callback in lib/auth.ts), which kicks out anyone else who was in.
  passwordChangedAt DateTime?

  // ---- Mentor availability (pause / remove) ----
  profileStatus  ProfileStatus @default(ACTIVE)
  pausedUntil    DateTime? // optional return date; profile shows again after this
  awayNote       String? // shown on the profile while paused
  removedAt      DateTime?
  removedReason  String?
  removedByAdmin Boolean       @default(false) // admin removal also blocks login

  // ---- Mentor-level search answers (asked once, used by every package) ----
  mentorStage String? // MS1, MS2, MS3, MS4, RESIDENT
  schoolType  String? // MD, DO, MD_PHD
  backgrounds String[] @default([]) // REAPPLICANT, NON_TRADITIONAL, FIRST_GEN, GAP_YEARS, CAREER_CHANGER

  // ---- Calls & calendars ----
  // calLink / calWebhookSecret: Cal.com, no longer used since Phase 3
  // (the built-in calendar replaced it). Kept so old data isn't lost.
  calLink          String?
  calWebhookSecret String?
  calendarToken    String? @unique // secret token for this user's calendar feed (.ics)

  // Every account's time zone (IANA name, e.g. "America/Chicago").
  // Detected in the browser at signup/login and editable on Account.
  // Used for call reminders (8am local) and times in emails.
  timeZone String?

  // ---- Built-in calendar (mentors) ----
  // Weekly hours: { "1": [["09:00","12:00"],["13:00","17:00"]], ... }
  // keyed by weekday (0 = Sunday), times in the mentor's time zone.
  weeklyHours           Json?
  bufferMinutes         Int       @default(15) // gap kept free before and after each call
  minNoticeHours        Int       @default(24) // how far ahead students must book
  daysOff               String[]  @default([]) // single dates with no calls, "YYYY-MM-DD"
  // A secret iCal address from Google / iCloud. Busy times in it are
  // blocked in the slot picker. The parsed busy times are cached here.
  externalCalUrl        String?
  externalBusy          Json? // [{ s: ISO, e: ISO }]
  externalBusyFetchedAt DateTime?
  externalCalError      String?

  busyDates      BusyDate[]
  callAttendance CallAttendance[]

  // ---- Safety (Phase 4) ----
  // Last time this person used the site (stamped at login and every few
  // minutes while logged in). Used for the "no login in 14 days" check.
  lastActiveAt           DateTime?
  // Paused pending review (by an admin, or automatically after 3 upheld
  // flags in 90 days). Students on hold can't send messages; mentors on
  // hold are hidden and can't unpause themselves.
  safetyHoldAt           DateTime?
  safetyHoldReason       String?
  // The mentor agreement (lib/agreement.ts) the mentor accepted, and when.
  mentorAgreementVersion String?
  mentorAgreementAt      DateTime?

  // ---- Legal, minors and admin team (Phase 5) ----
  // Date of birth (asked at signup; students who signed up earlier are
  // asked once). Under 13 can't have an account.
  dateOfBirth        DateTime? @db.Date
  // Students under 18: PENDING (waiting for a parent or guardian to
  // consent), CONSENTED, WITHDRAWN (parent withdrew or declined). Null for
  // adults; cleared automatically on the 18th birthday (becameAdultAt).
  minorStatus        String?
  becameAdultAt      DateTime?
  // Mentors: false = "I only work with students 18 and over".
  acceptsMinors      Boolean   @default(true)
  // Admin team: OWNER (manages the team) or ADMIN. Null on an admin = ADMIN.
  adminRole          String?
  adminDisabledAt    DateTime? // disabled admins can't log in
  sessionsRevokedAt  DateTime? // every login started before this is ended
  // Required 2-step verification for admins: TOTP (authenticator app) or EMAIL.
  twoFactorMethod    String?
  totpSecret         String? // encrypted (lib/totp.ts)
  totpLastStep       Int? // last code used, so a code can't be used twice
  twoFactorEnabledAt DateTime?

  legalAcceptances LegalAcceptance[]
  legalDocsCreated LegalDocument[]   @relation("LegalDocsCreatedBy")
  parentConsents   ParentConsent[]
  adminInvitesSent AdminInvite[]     @relation("AdminInvitesSent")
  adminMfaTokens   AdminMfaToken[]

  emailVerificationTokens EmailVerificationToken[]
  flagsAbout              Flag[]                   @relation("FlagsAbout")
  flagsReported           Flag[]                   @relation("FlagsReported")
  flagsResolved           Flag[]                   @relation("FlagsResolved")
  blocksMade              Block[]                  @relation("BlocksMade")
  blocksReceived          Block[]                  @relation("BlocksReceived")
  adminActions            AdminAction[]            @relation("AdminActionsBy")
  adminActionsAbout       AdminAction[]            @relation("AdminActionsAbout")

  accounts Account[] // one row per login method (Google, etc.) linked to this user
  sessions Session[]

  gigs                  Gig[]                @relation("SellerGigs")
  sentInvites           Invite[]             @relation("InvitesCreatedByAdmin")
  buyerOrders           Order[]              @relation("BuyerOrders")
  sellerOrders          Order[]              @relation("SellerOrders")
  messages              Message[]
  conversationsAsBuyer  Conversation[]       @relation("BuyerConversations")
  conversationsAsSeller Conversation[]       @relation("SellerConversations")
  reviewsWritten        Review[]             @relation("ReviewsByBuyer")
  reviewsReceived       Review[]             @relation("ReviewsOfSeller")
  disputeMessages       DisputeMessage[]
  passwordResetTokens   PasswordResetToken[]
}

// One row per "forgot password" request. Only a SHA-256 hash of the
// token is stored, so someone who reads the database still can't use a
// reset link. Links expire after an hour and work once.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// These two models are boilerplate required by NextAuth whenever you add
// an OAuth provider like Google - NextAuth needs somewhere to store the
// link between "this Google account" and "this User row," and to track
// active sessions. You never query these directly; NextAuth manages them.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The core access-control mechanism: a seller account can only be created
// by redeeming a code an admin generated. Nothing about seller signup is
// self-serve.
model Invite {
  id               String       @id @default(cuid())
  code             String       @unique
  email            String
  status           InviteStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  expiresAt        DateTime
  redeemedByUserId String?

  createdBy   User   @relation("InvitesCreatedByAdmin", fields: [createdById], references: [id])
  createdById String

  @@index([createdAt])
}

model Gig {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Int // cents, to avoid float rounding issues
  duration    String // display string, e.g. "48hr turnaround"
  category    GigCategory @default(OTHER)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  // Required search answers. A package missing any of these is hidden
  // from browse until the mentor fills them in (see lib/mentor.ts).
  service       String? // PERSONAL_STATEMENT, SECONDARIES, ... (lib/options.ts)
  serviceOther  String? // the mentor's own service name when service = OTHER, e.g. "CASPer prep"
  format        String? // WRITTEN, WRITTEN_CALL, LIVE
  turnaround    String? // H48, D3_5, W1_2, SCHEDULED
  callsIncluded Int     @default(0) // 0 for written-only packages
  callLength    Int? // minutes: 30, 45 or 60
  calEventUrl   String? // no longer used (Cal.com removed in Phase 3); kept for old data

  // The mentor agreement version accepted when this package was last
  // published or saved (lib/agreement.ts), and when.
  agreementVersion String?
  agreementAt      DateTime?

  seller   User   @relation("SellerGigs", fields: [sellerId], references: [id])
  sellerId String

  orders Order[]

  @@index([sellerId, active])
  @@index([active, category, createdAt])
  @@index([active, service])
}

model Order {
  id                    String      @id @default(cuid())
  status                OrderStatus @default(PENDING_PAYMENT)
  amount                Int // cents, snapshot of gig price at purchase time
  dueDate               DateTime? // buyer-selected deadline, set at checkout
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now())
  completedAt           DateTime?

  // The exact moment Stripe considers this payment's funds "available"
  // for payout - not a guess, this comes straight from Stripe's own
  // balance_transaction.available_on timestamp for the charge, fetched
  // once payment clears (see the webhook). A Transfer attempted before
  // this time can fail with an "insufficient available funds" error, so
  // releaseOrder() checks this before ever attempting one.
  fundsAvailableAt DateTime?

  // Stripe Transfer id once the seller has been paid - lets you match a
  // payout in the Stripe dashboard to its order.
  stripeTransferId String?

  // Revisions: an informal flag + note the buyer can raise mid-order,
  // separate from the message thread so it's visible as status at a
  // glance rather than buried in chat history.
  revisionRequested Boolean @default(false)
  revisionNote      String?

  // Disputes: buyer-raised, admin-resolved. A disputed order is NOT
  // auto-refunded - an admin reviews it and decides (see /api/orders/[id]/refund
  // and /api/orders/[id]/release, both of which an admin can call regardless
  // of who normally would).
  disputed      Boolean @default(false)
  disputeReason String?

  // Scheduling: an optional specific time for the video call, proposed
  // and confirmed between buyer and seller via messages, then locked in
  // here so it shows clearly on the order itself.
  scheduledCallTime DateTime?

  // Completion flow: the seller marks work done (status -> COMPLETED),
  // which starts a 48-hour window. The buyer can confirm early (which
  // releases immediately) or do nothing - either way, a cron job
  // auto-releases the payment once 48 hours have passed since
  // workCompletedAt. See /api/orders/[id]/mark-complete and
  // /api/cron/auto-release.
  workCompletedAt DateTime?

  // Tracks the last time a "your work is overdue" reminder email was
  // sent to the seller, so the daily cron sends at most one per day
  // rather than one per cron run.
  reminderLastSentAt DateTime?

  // Discounts: set at checkout if a valid code was applied. No longer
  // reachable from the checkout page (removed per product decision),
  // but left in the schema in case discount codes come back later -
  // admin can still create them, they just won't be applied anywhere
  // right now.
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountCodeId String?

  gig      Gig    @relation(fields: [gigId], references: [id])
  gigId    String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId String

  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?

  review          Review?
  disputeMessages DisputeMessage[]
  callBookings    CallBooking[]
  deliveries      Delivery[]

  // ---- Unbooked-call rule (see lib/calls.ts) ----
  callReminderSentAt DateTime? // last "book your call" reminder to the student
  callHoldAt         DateTime? // due date passed with a call still unbooked: order paused
  callWaivedAt       DateTime? // student said they don't need the call
  callForfeitedAt    DateTime? // student didn't book within 48h of the hold

  // ---- Dispute outcome, for the admin's Resolved list ----
  disputeResolvedAt DateTime?
  disputeResolution String? // REFUNDED or RELEASED

  // The package's turnaround when the order was placed. Changing a
  // package's turnaround only affects new orders.
  turnaround String?

  // Postgres doesn't index foreign keys automatically. Without these,
  // every "my orders" page and every cron run scans the whole table.
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, workCompletedAt])
  @@index([status, dueDate])
  @@index([disputed, status])
  @@index([gigId])
  @@index([conversationId])
}

// One row each time the mentor marks the work complete. A revision
// request sends the order back to the mentor, and the next "Mark work as
// complete" adds Delivery 2, 3... Older deliveries are never deleted, so
// the student (and an admin, in a dispute) can see the whole history.
model Delivery {
  id          String   @id @default(cuid())
  number      Int // 1, 2, 3... per order
  description String
  // [{ url, name }] - files uploaded through /api/upload (Vercel Blob).
  files       Json     @default("[]")
  createdAt   DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  @@unique([orderId, number])
}

// A separate thread from the regular buyer/seller Conversation, created
// implicitly the moment a dispute is opened. Buyer, seller, and any admin
// can all post here - this is specifically where an admin asks follow-up
// questions to understand what happened before deciding to refund or
// release. Kept distinct from the regular message thread so there's a
// clean, dedicated record of the dispute itself.
model DisputeMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  @@index([orderId, createdAt])
}

// One row per call booked on an order. Since Phase 3 every call is booked
// on MentorsMD itself (the student picks a slot from the mentor's
// availability) and happens in a private Daily room. Old rows from Cal.com
// keep source "CAL".
model CallBooking {
  id             String     @id @default(cuid())
  startTime      DateTime
  endTime        DateTime
  status         CallStatus @default(BOOKED)
  source         String     @default("SITE") // SITE (built-in calendar), MANUAL (mentor added), CAL (old)
  calUid         String?    @unique // old Cal.com booking uid
  meetingUrl     String? // old Cal.com video link (no longer used)
  reminderSentAt DateTime? // old, unused
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Daily room for this call (private; people join with a meeting token).
  roomName                 String?
  roomUrl                  String?
  // When the time was last set (booked or rescheduled), and by whom.
  scheduledAt              DateTime?
  bookedById               String?
  cancelledAt              DateTime?
  cancelledById            String?
  // Bumped on every reschedule, so calendar apps replace the old invite.
  icsSequence              Int       @default(0)
  // Reminders: each is sent once. A reschedule clears them.
  morningReminderStudentAt DateTime?
  morningReminderMentorAt  DateTime?
  hourReminderAt           DateTime?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  attendance CallAttendance[]
  recordings CallRecording[]

  @@index([orderId, startTime])
  @@index([status, startTime])
  @@index([roomName])
}

// Who joined a call and when (from Daily's webhooks).
model CallAttendance {
  id          String    @id @default(cuid())
  sessionId   String    @unique // Daily's participant session id
  name        String?
  joinedAt    DateTime
  leftAt      DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())

  booking   CallBooking @relation(fields: [bookingId], references: [id])
  bookingId String
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?

  @@index([bookingId, joinedAt])
}

// Cloud recordings of a call (admin-only). The video itself stays on
// Daily; we keep its id and delete it 60 days after the order closes.
model CallRecording {
  id               String    @id @default(cuid())
  dailyRecordingId String    @unique
  status           String?
  startedAt        DateTime?
  durationSec      Int?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  booking   CallBooking @relation(fields: [bookingId], references: [id])
  bookingId String

  @@index([deletedAt, createdAt])
}

// A mentor's busy dates (exams, rotations, travel). The note is private.
// NO_DEADLINES: students can't pick a due date in the range.
// NO_DEADLINES_NO_CALLS: no due dates and no calls in the range.
// Days are calendar dates ("YYYY-MM-DD"), both ends included.
model BusyDate {
  id        String   @id @default(cuid())
  startDay  String
  endDay    String
  kind      String   @default("NO_DEADLINES")
  note      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, startDay])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique // one review per order, enforced at the database level

  buyer    User   @relation("ReviewsByBuyer", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("ReviewsOfSeller", fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId, createdAt])
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int? // e.g. 20 for 20% off - use this OR amountOffCents, not both
  amountOffCents Int? // fixed dollar amount off, in cents
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxRedemptions Int? // null = unlimited
  redemptions    Int       @default(0)
  createdAt      DateTime  @default(now())

  orders Order[]
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  buyer    User   @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerConversations", fields: [sellerId], references: [id])
  sellerId String

  // Last time each side was emailed about new messages here - used to
  // send at most one notification email per 15 minutes per conversation.
  buyerNotifiedAt  DateTime?
  sellerNotifiedAt DateTime?

  // Unread message counts for each side. Sending a message adds one to
  // the other person's count; opening the conversation resets yours.
  buyerUnread  Int @default(0)
  sellerUnread Int @default(0)

  messages Message[]
  orders   Order[]

  @@unique([buyerId, sellerId])
  @@index([sellerId, createdAt])
  @@index([buyerId, buyerUnread])
  @@index([sellerId, sellerUnread])
}

model Message {
  id             String   @id @default(cuid())
  body           String
  attachmentUrl  String? // set if a file was attached, via /api/upload
  attachmentName String? // original filename, shown in the UI
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId])
}

// Someone applying to mentor via /become-a-mentor/apply. An admin reviews
// it in Admin -> Applications and either invites them (the normal invite
// flow) or declines.
model MentorApplication {
  id            String            @id @default(cuid())
  name          String
  email         String
  phone         String
  medicalSchool String
  residency     String?
  blurb         String
  resumeUrl     String
  resumeName    String
  status        ApplicationStatus @default(PENDING)
  // SHA-256 of the sender's IP (never the IP itself), for the simple
  // "too many applications from here" limit.
  ipHash        String?
  createdAt     DateTime          @default(now())
  decidedAt     DateTime?
  inviteId      String?

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------- Safety and integrity (Phase 4) ----------------

// "Confirm your email" links. Only a SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// Fallback rate-limit counters, used only when Upstash Redis isn't set
// up. One row per (limit, person or IP, time window); old rows are
// cleaned up by the daily safety cron.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// One item in Admin -> Flags: a student/mentor report, a dispute, or an
// automatic flag (word filter, off-site contact, ghostwriting, links, AI
// check, performance). Severity: 1 low, 2 medium, 3 high.
// Status: OPEN, DISMISSED, UPHELD (an admin warned, paused or removed).
model Flag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String // REPORT, DISPUTE, LANGUAGE, OFF_SITE, GHOSTWRITING, CREDENTIALS, LINK, AI, PERFORMANCE, BLOCKED_MESSAGE
  source    String   @default("AUTO") // USER, AUTO, AI, CRON, SYSTEM
  severity  Int      @default(1)
  status    String   @default("OPEN")
  reason    String // short title, e.g. "Asked to pay outside MentorsMD"
  details   String? // longer explanation / the reporter's words
  evidence  String? // the text that triggered it (message excerpt)
  matches   String[] @default([]) // words/phrases to highlight in the evidence
  dedupeKey String? // stops the daily checks raising the same flag again

  subject       User?   @relation("FlagsAbout", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectUserId String?
  reporter      User?   @relation("FlagsReported", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId    String?

  conversationId String?
  messageId      String?
  orderId        String?
  gigId          String?

  action         String? // DISMISS, WARN, PAUSE, REMOVE, REFUND, RELEASE, AUTO_PAUSE
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedBy     User?     @relation("FlagsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById   String?
  emailedAt      DateTime? // high-severity alert sent to admins

  @@index([status, severity, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([dedupeKey, createdAt])
  @@index([orderId])
  @@index([conversationId, createdAt])
}

// Someone blocked someone: neither can message the other.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Admin action log: who did what, to whom, when.
model AdminAction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String // e.g. FLAG_DISMISS, USER_PAUSE, ORDER_REFUND, INVITE_SENT
  targetType String? // USER, ORDER, FLAG, INVITE, APPLICATION
  targetId   String?
  summary    String
  details    Json?

  admin        User?   @relation("AdminActionsBy", fields: [adminId], references: [id], onDelete: SetNull)
  adminId      String? // null = done automatically by the system
  targetUser   User?   @relation("AdminActionsAbout", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserId String?

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

// ---------------- Legal, minors and admin team (Phase 5) ----------------

// A version of one legal document, edited in Admin -> Legal. Drafts have
// no version number; publishing gives the next number (1, 2, 3...).
// changeType MAJOR = everyone must accept it again (blocking screen);
// MINOR = small fix, earlier acceptances still count. Version 1 is always
// treated as MAJOR: publishing it switches the requirement on.
model LegalDocument {
  id          String    @id @default(cuid())
  kind        String // TERMS, PRIVACY, MENTOR_AGREEMENT, COMMUNITY_GUIDELINES, PARENTAL_CONSENT
  version     Int?
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  title       String
  body        String
  changeType  String    @default("MAJOR") // MAJOR, MINOR
  changeNote  String? // "What changed", shown on the blocking screen
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  publishedAt DateTime?

  createdBy     User?   @relation("LegalDocsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?
  publishedById String?

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, status, publishedAt])
}

// One row each time someone accepts a legal document (or a parent signs
// the parental consent form): which version, when, from which IP and
// browser. version 0 = the built-in text, before any version was published.
model LegalAcceptance {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  version    Int
  context    String // SIGNUP, GOOGLE_SIGNUP, PROMPT, MENTOR_JOIN, PARENT_CONSENT
  email      String // the account's email at the time (the parent's, for PARENT_CONSENT)
  signerName String? // typed signature (parent consent)
  ip         String?
  userAgent  String?

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  document   LegalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  @@index([userId, kind, version])
  @@index([kind, version, createdAt])
  @@index([createdAt])
}

// Consent from a parent or guardian for a student aged 13-17. The link
// emailed to the parent works for 7 days (only its hash is stored;
// reminders send a fresh link with the same expiry). viewToken is the
// parent's private link to order and call history.
model ParentConsent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  status             String    @default("PENDING") // PENDING, CONSENTED, DECLINED, EXPIRED, WITHDRAWN, REPLACED
  parentName         String
  parentEmail        String
  parentPhone        String
  tokenHash          String    @unique
  expiresAt          DateTime
  lastSentAt         DateTime?
  remindersSent      Int       @default(0)
  consentedAt        DateTime?
  signatureName      String?
  ip                 String?
  userAgent          String?
  termsVersion       Int?
  consentFormVersion Int?
  viewToken          String?   @unique
  withdrawnAt        DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Admin -> Team invites. The invitee opens the emailed link, picks a name
// and password, and becomes an admin. Only the hash of the link is stored.
model AdminInvite {
  id             String    @id @default(cuid())
  email          String
  adminRole      String    @default("ADMIN") // OWNER or ADMIN
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  acceptedUserId String?

  invitedBy   User?   @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?

  @@index([createdAt])
}

// Admin 2-step verification: emailed codes (EMAIL_CODE) and the one-time
// ticket that upgrades a login once the code is right (SESSION).
model AdminMfaToken {
  id        String    @id @default(cuid())
  kind      String // EMAIL_CODE, SESSION
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, kind, createdAt])
}

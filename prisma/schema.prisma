// Database schema for the invite-gated coaching marketplace.
// Apply changes to the database with: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL should be your provider's POOLED connection string (Neon:
// the "-pooler" host; Supabase: port 6543 with ?pgbouncer=true). On
// Vercel every request can spin up a new function instance with its own
// connections, and a direct URL runs out of connections under load.
// DIRECT_URL is the normal non-pooled string, used only by migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum InviteStatus {
  PENDING
  REDEEMED
  EXPIRED
  REVOKED
}

// Mentor visibility. PAUSED mentors are hidden from search until their
// return date (pausedUntil) passes, or until they unpause. REMOVED mentors
// are hidden entirely. A student REMOVED by an admin can't log in.
enum ProfileStatus {
  ACTIVE
  PAUSED
  REMOVED
}

enum CallStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING_PAYMENT
  IN_ESCROW
  COMPLETED
  RELEASED
  REFUNDED
  CANCELLED
}

// A simple fixed list rather than free text, so filtering on the coaches
// page actually works reliably (free-text categories would fragment into
// a dozen near-duplicate spellings). Add more values here if you need a
// category this list doesn't cover yet - Prisma migrations handle enum
// changes fine.
// Mentor applications from the public /become-a-mentor/apply form.
enum ApplicationStatus {
  PENDING
  INVITED
  DECLINED
}

enum GigCategory {
  ESSAY_REVIEW
  MOCK_INTERVIEW
  APPLICATION_STRATEGY
  TUTORING
  OTHER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String? // set automatically by Google sign-in; separate from photoUrl below
  passwordHash  String? // optional now - a Google-only account has no password on our side
  role          Role      @default(BUYER)
  name          String
  createdAt     DateTime  @default(now())

  // Seller-only profile fields. Null for buyers/admins.
  credential      String?
  bio             String?
  photoUrl        String?
  stripeAccountId String? // Stripe Connect account id, once onboarded

  // Login rate limiting - tracks repeated failed password attempts so a
  // brute-force guessing attack gets locked out rather than allowed to
  // keep trying indefinitely. See the authorize() function in lib/auth.ts.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Set whenever the password is reset or changed. Any login session
  // started before this moment is ended within ~5 minutes (see the jwt
  // callback in lib/auth.ts), which kicks out anyone else who was in.
  passwordChangedAt DateTime?

  // ---- Mentor availability (pause / remove) ----
  profileStatus  ProfileStatus @default(ACTIVE)
  pausedUntil    DateTime? // optional return date; profile shows again after this
  awayNote       String? // shown on the profile while paused
  removedAt      DateTime?
  removedReason  String?
  removedByAdmin Boolean       @default(false) // admin removal also blocks login

  // ---- Mentor-level search answers (asked once, used by every package) ----
  mentorStage     String? // UNDERGRAD, MS1, MS2, MS3, MS4, RESIDENT
  // Undergrads in a BS/MD program (stage UNDERGRAD): their college. Shown
  // instead of the medical school, which is optional for them.
  undergradSchool String?
  schoolType      String? // MD, DO, MD_PHD
  // No longer used since the Oct 2026 redesign: "Who you're best for"
  // (bestFor below) replaced it everywhere. Kept so old data isn't lost.
  backgrounds     String[] @default([]) // REAPPLICANT, NON_TRADITIONAL, FIRST_GEN, GAP_YEARS, CAREER_CHANGER

  // ---- Mentor profile sections (redesign Oct 2026, docs/redesign-2026-10.md section 2) ----
  // A mentor is listed only once every section is filled in
  // (lib/profileCompleteness.ts). The bio is the `bio` field above.
  // Admissions experience: "Have you served on a medical school admissions
  // committee, or as an interviewer or application screener?" (null = not
  // answered yet). Yes -> admissionsRoles lists the roles; No -> no roles.
  hasAdmissionsRoles  Boolean?
  // [{ type: COMMITTEE | INTERVIEWER | SCREENER, place, years, former }]
  admissionsRoles     Json?
  yearsAdvising       Int? // optional
  applicantsSupported Int? // optional: approximate number of applicants helped
  strongestStages     String[]  @default([]) // SCHOOL_LIST, PERSONAL_STATEMENT, ... (lib/options.ts STRONGEST_STAGES)
  // Clinical & research
  specialtyInterest   String?
  researchSummary     String? // research interests and accomplishments, 3-4 sentences
  // Who you're best for (lib/options.ts BEST_FOR), plus an optional "Other".
  bestFor             String[]  @default([])
  bestForOther        String?
  highlights          String[]  @default([]) // credentials & highlights, 4-6 bullets
  knownFor            String[]  @default([]) // exactly 3 short bullets
  // [{ name, level: NATIVE | FLUENT | CONVERSATIONAL, canAdvise }]
  languages           Json?
  funFact             String?
  // One hourly rate per mentor, in cents (min $50, whole dollars). Every
  // offer's price is hours x rate (lib/pricing.ts).
  hourlyRateCents     Int?
  // Set by lib/profileCompleteness.ts whenever the profile or rate is
  // saved: when all 10 sections were last complete. Null = incomplete,
  // hidden from Browse and can't be bought from.
  profileCompleteAt   DateTime?

  // ---- Calls & calendars ----
  // calLink / calWebhookSecret: Cal.com, no longer used since Phase 3
  // (the built-in calendar replaced it). Kept so old data isn't lost.
  calLink          String?
  calWebhookSecret String?
  calendarToken    String? @unique // secret token for this user's calendar feed (.ics)

  // Every account's time zone (IANA name, e.g. "America/Chicago").
  // Detected in the browser at signup/login and editable on Account.
  // Used for call reminders (8am local) and times in emails.
  timeZone String?

  // ---- Built-in calendar (mentors) ----
  // Weekly hours: { "1": [["09:00","12:00"],["13:00","17:00"]], ... }
  // keyed by weekday (0 = Sunday), times in the mentor's time zone.
  weeklyHours           Json?
  bufferMinutes         Int       @default(15) // gap kept free before and after each call
  minNoticeHours        Int       @default(24) // how far ahead students must book
  bookingWindowDays     Int       @default(60) // how far into the future students can book (lib/schedule.ts BOOKING_WINDOW_OPTIONS)
  daysOff               String[]  @default([]) // single dates with no calls, "YYYY-MM-DD"
  // A secret iCal address from Google / iCloud. Busy times in it are
  // blocked in the slot picker. The parsed busy times are cached here.
  externalCalUrl        String?
  externalBusy          Json? // [{ s: ISO, e: ISO }]
  externalBusyFetchedAt DateTime?
  externalCalError      String?
  // One-click Google Calendar connection (lib/googleCalendar.ts), used
  // instead of / as well as the iCal link. Its busy times go into
  // externalBusy above. The refresh token is encrypted (AES-256-GCM).
  googleCalEmail        String?
  googleCalRefreshToken String?
  googleCalConnectedAt  DateTime?

  busyDates      BusyDate[]
  callAttendance CallAttendance[]

  // ---- Safety (Phase 4) ----
  // Last time this person used the site (stamped at login and every few
  // minutes while logged in). Used for the "no login in 14 days" check.
  lastActiveAt           DateTime?
  // Paused pending review (by an admin, or automatically after 3 upheld
  // flags in 90 days). Students on hold can't send messages; mentors on
  // hold are hidden and can't unpause themselves.
  safetyHoldAt           DateTime?
  safetyHoldReason       String?
  // The mentor agreement (lib/agreement.ts) the mentor accepted, and when.
  mentorAgreementVersion String?
  mentorAgreementAt      DateTime?

  // ---- Legal, minors and admin team (Phase 5) ----
  // Date of birth (asked at signup; students who signed up earlier are
  // asked once). Under 13 can't have an account.
  dateOfBirth         DateTime?        @db.Date
  // Students under 18: PENDING (waiting for a parent or guardian to
  // consent), CONSENTED, WITHDRAWN (parent withdrew or declined). Null for
  // adults; cleared automatically on the 18th birthday (becameAdultAt).
  minorStatus         String?
  becameAdultAt       DateTime?
  // Mentors: false = "I only work with students 18 and over".
  acceptsMinors       Boolean          @default(true)
  // Admin team: OWNER (manages the team) or ADMIN. Null on an admin = ADMIN.
  adminRole           String?
  // Custom role (Admin -> Team -> Roles). Set: only that role's ticked
  // areas. Null: full access (Owner or Admin).
  adminCustomRole     AdminCustomRole? @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  adminRoleId         String?
  adminDisabledAt     DateTime? // disabled admins can't log in
  sessionsRevokedAt   DateTime? // every login started before this is ended
  // 2-step verification (lib/mfa.ts): TOTP (authenticator app) or EMAIL
  // (a 6-digit code by email). Required for admins and mentors (a mentor
  // with nothing set gets email codes); students can turn it on.
  twoFactorMethod     String?
  totpSecret          String? // encrypted (lib/totp.ts)
  totpLastStep        Int? // last code used, so a code can't be used twice
  twoFactorEnabledAt  DateTime?
  // "Trust this device for 30 days": devices trusted before this time
  // need a code again ("Forget my trusted devices", or an Owner's reset).
  twoFactorTrustAfter DateTime?

  // ---- Reminder emails (lib/scheduledEmails.ts) ----
  // Set when they press "Stop these reminders" in a reminder email: no
  // more time-based reminders (abandoned checkout, finish your profile...).
  // Emails about their orders, calls and messages still go out.
  remindersOffAt DateTime?

  // ---- Insights (Phase 6) ----
  // Mentors: their medical school (picked from lib/medicalSchools.ts, or
  // typed in when it isn't listed). Copied from the mentor application.
  medicalSchool String?
  // How this account first found MentorsMD (first visit, before signup):
  // "google", "instagram", "direct", "referral"... (lib/attribution.ts),
  // and the detail behind it (campaign, referring site, landing page).
  signupSource  String?
  signupDetail  String?

  // ---- Student profile (Oct 2026, all optional; lib/studentProfile.ts) ----
  // Shown only to mentors the student has messaged, booked or bought from.
  studentApplyYear String? // "2026" | "2027" | "2028_PLUS"
  studentStage     String? // STUDENT_STAGES: SCHOOL_LIST, PERSONAL_STATEMENT, ...
  studentDegree    String? // MD | DO | BOTH
  studentSchool    String? // undergrad school or state
  studentHelpWith  String[]  @default([]) // SERVICES values (lib/options.ts)
  studentAbout     String? // up to 300 characters
  // Last time they saved it, or pressed "Skip for now" after signup (so the
  // after-signup step isn't shown again).
  studentProfileAt DateTime?

  activityEvents ActivityEvent[]

  legalAcceptances LegalAcceptance[]
  legalDocsCreated LegalDocument[]   @relation("LegalDocsCreatedBy")
  parentConsents   ParentConsent[]
  adminInvitesSent AdminInvite[]     @relation("AdminInvitesSent")
  adminMfaTokens   AdminMfaToken[]
  appSessions      AppSession[]

  emailVerificationTokens EmailVerificationToken[]
  flagsAbout              Flag[]                   @relation("FlagsAbout")
  flagsReported           Flag[]                   @relation("FlagsReported")
  flagsResolved           Flag[]                   @relation("FlagsResolved")
  blocksMade              Block[]                  @relation("BlocksMade")
  blocksReceived          Block[]                  @relation("BlocksReceived")
  adminActions            AdminAction[]            @relation("AdminActionsBy")
  adminActionsAbout       AdminAction[]            @relation("AdminActionsAbout")

  accounts Account[] // one row per login method (Google, etc.) linked to this user
  sessions Session[]

  gigs                  Gig[]                @relation("SellerGigs")
  sentInvites           Invite[]             @relation("InvitesCreatedByAdmin")
  buyerOrders           Order[]              @relation("BuyerOrders")
  sellerOrders          Order[]              @relation("SellerOrders")
  messages              Message[]
  conversationsAsBuyer  Conversation[]       @relation("BuyerConversations")
  conversationsAsSeller Conversation[]       @relation("SellerConversations")
  reviewsWritten        Review[]             @relation("ReviewsByBuyer")
  reviewsReceived       Review[]             @relation("ReviewsOfSeller")
  disputeMessages       DisputeMessage[]
  passwordResetTokens   PasswordResetToken[]
  // Leads inbox (Admin -> Leads)
  leadsAssigned         Lead[]               @relation("LeadAssignee")
  applicationsAssigned  MentorApplication[]  @relation("ApplicationAssignee")
  leadNotes             LeadNote[]           @relation("LeadNoteAuthor")

  // ---- Redesign Oct 2026 ----
  introCallsAsStudent CallBooking[]  @relation("IntroCallStudent")
  introCallsAsMentor  CallBooking[]  @relation("IntroCallMentor")
  hourEntriesLogged   HourEntry[]    @relation("HourEntryLoggedBy")
  hourTopUps          HourTopUp[]    @relation("HourTopUpBuyer")
  creditEntries       CreditEntry[]  @relation("CreditOwner")
  creditEntriesByMe   CreditEntry[]  @relation("CreditAdmin")
  mentorPayouts       MentorPayout[] @relation("MentorPayouts")
}

// One row per "forgot password" request. Only a SHA-256 hash of the
// token is stored, so someone who reads the database still can't use a
// reset link. Links expire after an hour and work once.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// These two models are boilerplate required by NextAuth whenever you add
// an OAuth provider like Google - NextAuth needs somewhere to store the
// link between "this Google account" and "this User row," and to track
// active sessions. You never query these directly; NextAuth manages them.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The core access-control mechanism: a seller account can only be created
// by redeeming a code an admin generated. Nothing about seller signup is
// self-serve.
model Invite {
  id               String       @id @default(cuid())
  code             String       @unique
  email            String
  status           InviteStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  expiresAt        DateTime
  redeemedByUserId String?

  createdBy   User   @relation("InvitesCreatedByAdmin", fields: [createdById], references: [id])
  createdById String

  @@index([createdAt])
}

model Gig {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Int // cents, to avoid float rounding issues
  duration    String // display string, e.g. "48hr turnaround"
  category    GigCategory @default(OTHER)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  // Required search answers. A package missing any of these is hidden
  // from browse until the mentor fills them in (see lib/mentor.ts).
  service       String? // PERSONAL_STATEMENT, SECONDARIES, ... (lib/options.ts)
  serviceOther  String? // the mentor's own service name when service = OTHER, e.g. "CASPer prep"
  format        String? // WRITTEN, WRITTEN_CALL, LIVE
  turnaround    String? // H48, D3_5, W1_2, SCHEDULED
  callsIncluded Int     @default(0) // 0 for written-only packages
  callLength    Int? // minutes: 30, 45 or 60
  calEventUrl   String? // no longer used (Cal.com removed in Phase 3); kept for old data

  // The mentor agreement version accepted when this package was last
  // published or saved (lib/agreement.ts), and when.
  agreementVersion String?
  agreementAt      DateTime?

  // ---- Offers (redesign Oct 2026, docs/redesign-2026-10.md section 3) ----
  // HOURLY (one per mentor: 1 hour at the hourly rate; `active` is its
  // on/off switch), BUNDLE (N hours) or SPECIALIZED (a titled package with
  // estimated hours). Null = a package from before the redesign (priced by
  // hand, with due dates and calls); those are no longer shown to students.
  // For new offers, `price` is kept equal to minutes/60 x the rate
  // (lib/pricing.ts), so browse can still filter by price band; the
  // turnaround / callsIncluded / callLength / duration columns are unused.
  kind      String?
  minutes   Int? // hours in the offer (bundle) or estimated hours (package), in minutes
  rateCents Int? // its own per-hour rate; null = the mentor's hourly rate
  // Optional cover photo (public-media), with its focus point saved on the
  // address like Admin -> Website photos (lib/imageFocus.ts).
  coverUrl  String?
  sortOrder Int     @default(0)

  seller   User   @relation("SellerGigs", fields: [sellerId], references: [id])
  sellerId String

  orders Order[]

  @@index([sellerId, active])
  @@index([sellerId, kind, active])
  @@index([active, category, createdAt])
  @@index([active, service])
}

model Order {
  id                    String      @id @default(cuid())
  status                OrderStatus @default(PENDING_PAYMENT)
  amount                Int // cents, snapshot of gig price at purchase time
  dueDate               DateTime? // buyer-selected deadline, set at checkout
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now())
  completedAt           DateTime?

  // The exact moment Stripe considers this payment's funds "available"
  // for payout - not a guess, this comes straight from Stripe's own
  // balance_transaction.available_on timestamp for the charge, fetched
  // once payment clears (see the webhook). A Transfer attempted before
  // this time can fail with an "insufficient available funds" error, so
  // releaseOrder() checks this before ever attempting one.
  fundsAvailableAt DateTime?

  // Stripe Transfer id once the seller has been paid - lets you match a
  // payout in the Stripe dashboard to its order.
  stripeTransferId String?

  // Revisions: an informal flag + note the buyer can raise mid-order,
  // separate from the message thread so it's visible as status at a
  // glance rather than buried in chat history.
  revisionRequested Boolean @default(false)
  revisionNote      String?

  // Disputes: buyer-raised, admin-resolved. A disputed order is NOT
  // auto-refunded - an admin reviews it and decides (see /api/orders/[id]/refund
  // and /api/orders/[id]/release, both of which an admin can call regardless
  // of who normally would).
  disputed      Boolean @default(false)
  disputeReason String?

  // Scheduling: an optional specific time for the video call, proposed
  // and confirmed between buyer and seller via messages, then locked in
  // here so it shows clearly on the order itself.
  scheduledCallTime DateTime?

  // Completion flow: the seller marks work done (status -> COMPLETED),
  // which starts a 48-hour window. The buyer can confirm early (which
  // releases immediately) or do nothing - either way, a cron job
  // auto-releases the payment once 48 hours have passed since
  // workCompletedAt. See /api/orders/[id]/mark-complete and
  // /api/cron/auto-release.
  workCompletedAt DateTime?

  // Tracks the last time a "your work is overdue" reminder email was
  // sent to the seller, so the daily cron sends at most one per day
  // rather than one per cron run.
  reminderLastSentAt DateTime?

  gig      Gig    @relation(fields: [gigId], references: [id])
  gigId    String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId String

  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?

  review          Review?
  disputeMessages DisputeMessage[]
  callBookings    CallBooking[]
  deliveries      Delivery[]

  // ---- Unbooked-call rule (see lib/calls.ts) ----
  callReminderSentAt DateTime? // last "book your call" reminder to the student
  callHoldAt         DateTime? // due date passed with a call still unbooked: order paused
  callWaivedAt       DateTime? // student said they don't need the call
  callForfeitedAt    DateTime? // student didn't book within 48h of the hold

  // ---- Dispute outcome, for the admin's Resolved list ----
  disputeResolvedAt DateTime?
  disputeResolution String? // REFUNDED, RELEASED, or CREDIT (refunded as MentorsMD credit, hours packages)

  // The package's turnaround when the order was placed. Changing a
  // package's turnaround only affects new orders.
  turnaround String?

  // When the payment cleared and when it was refunded (Phase 6, for Admin
  // -> Insights). Orders from before Phase 6 have neither; their order
  // date is used instead.
  paidAt     DateTime?
  refundedAt DateTime?

  // ---- Hours (redesign Oct 2026, docs/redesign-2026-10.md sections 4-7) ----
  // Orders made after the redesign have a kind; for them dueDate, turnaround,
  // scheduledCallTime, revisionRequested/revisionNote, reminderLastSentAt,
  // the call hold/forfeit columns and workCompletedAt are unused.
  // kind: HOURLY | BUNDLE | SPECIALIZED | PAY_PER_CALL. A pay-per-call
  // order points at the mentor's HOURLY offer (gigId is required).
  kind               String?
  // Hours bought, in minutes, including paid top-ups (HourTopUp adds to it).
  minutesPurchased   Int           @default(0)
  // The per-hour rate this order paid, in cents. Top-ups use the same
  // rate; changing an offer's rate never changes an existing order.
  rateCents          Int?
  format             String? // WRITTEN, LIVE or WRITTEN_CALL, copied from the offer
  // What was bought, copied at checkout (offers can change later).
  packageTitle       String?
  packageDescription String?
  // MentorsMD credit spent on this order at checkout, in cents (the rest
  // was charged by Stripe; `amount` is the full price).
  creditAppliedCents Int           @default(0)
  // Finishing (section 5): the mentor clicks "Mark work complete"; the
  // student has until responseDeadline (48 hours) to approve, ask for one
  // last call / one last revision (once each), or open a dispute.
  markedCompleteAt   DateTime?
  responseDeadline   DateTime?
  lastCallUsedAt     DateTime?
  lastRevisionUsedAt DateTime?
  lastRequestNote    String?
  approvedAt         DateTime?
  autoApproved       Boolean       @default(false)
  // "1 hour left" reminder sent to the student (once per order).
  lowHoursEmailAt    DateTime?
  // Pay-per-call orders: the call time the student picked before paying.
  // Booked when the payment clears; left set (with no call booked) when
  // that time was taken meanwhile, so the order page asks them to pick
  // another time.
  requestedCallStart DateTime?
  // Unused hours are paid to the mentor once the order is approved: how
  // many minutes that was, and the monthly payout that paid them.
  unusedMinutesPaid  Int?
  payout             MentorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId           String?

  hourEntries   HourEntry[]
  topUps        HourTopUp[]
  messages      Message[]
  creditEntries CreditEntry[]

  // Postgres doesn't index foreign keys automatically. Without these,
  // every "my orders" page and every cron run scans the whole table.
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, workCompletedAt])
  @@index([status, dueDate])
  @@index([disputed, status])
  @@index([gigId])
  @@index([conversationId])
  @@index([status, responseDeadline])
  @@index([payoutId])
}

// ---------------- Hours (redesign Oct 2026) ----------------

// The hours log of one order (docs/redesign-2026-10.md section 4): each
// call held (added automatically, using the booked length) or block of
// written work the mentor logged, 30 or 60 minutes. Paid to the mentor in
// the monthly payout (payoutId) once logged.
model HourEntry {
  id        String    @id @default(cuid())
  type      String // CALL | WRITTEN
  minutes   Int // 30 or 60
  workDate  DateTime // the day the work was done / the call started
  note      String?
  // Optional file with written work: private storage path (lib/storage.ts).
  fileUrl   String?
  fileName  String?
  createdAt DateTime  @default(now())
  // Taken back by an admin (e.g. after a dispute). Voided entries don't
  // count as used and aren't paid.
  voidedAt  DateTime?

  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String
  loggedBy      User?         @relation("HourEntryLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  loggedById    String? // null = added automatically (a call that was held)
  // The call this entry is for (CALL entries); one entry per call.
  callBooking   CallBooking?  @relation(fields: [callBookingId], references: [id])
  callBookingId String?       @unique
  payout        MentorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId      String?

  @@index([orderId, workDate])
  @@index([payoutId])
  @@index([createdAt])
}

// "Add hours" to an active order (section 4): 1, 2, 3 or 5 hours at the
// order's own per-hour rate. PENDING until Stripe confirms the payment;
// then the minutes are added to Order.minutesPurchased.
model HourTopUp {
  id                    String    @id @default(cuid())
  minutes               Int
  rateCents             Int
  amountCents           Int // full price; creditAppliedCents of it paid with credit
  creditAppliedCents    Int       @default(0)
  status                String    @default("PENDING") // PENDING | PAID | CANCELLED
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String
  buyer   User   @relation("HourTopUpBuyer", fields: [buyerId], references: [id])
  buyerId String

  @@index([orderId, createdAt])
  @@index([buyerId, createdAt])
}

// MentorsMD credit (section 6): one row per change to a student's
// balance, in cents (+ issued, - spent). Balance = sum of amountCents.
// Credit never expires and can be spent with any mentor.
model CreditEntry {
  id          String   @id @default(cuid())
  amountCents Int
  // DISPUTE_REFUND | ADMIN_ADJUST | SPENT | SPENT_REVERSED | GIFT (bought by a parent, lib/gifts.ts)
  reason      String
  note        String?
  createdAt   DateTime @default(now())

  user    User    @relation("CreditOwner", fields: [userId], references: [id])
  userId  String
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?
  topUpId String? // a top-up the credit was spent on
  admin   User?   @relation("CreditAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  adminId String? // the admin who issued/adjusted it; null = automatic

  @@index([userId, createdAt])
  @@index([orderId])
}

// One Stripe transfer per mentor per month (section 7), made on the 24th:
// everything not yet paid (hours logged or held up to then, plus the
// unused hours of orders approved by then). period = "YYYY-MM", so a run
// can't pay the same mentor twice in a month.
model MentorPayout {
  id               String    @id @default(cuid())
  period           String
  cutoffAt         DateTime // entries and approvals up to this moment are included
  amountCents      Int // what the mentor receives (70%)
  grossCents       Int       @default(0) // what students paid for those hours
  minutes          Int       @default(0)
  entryCount       Int       @default(0)
  status           String    @default("PENDING") // PROCESSING (claimed, transfer being sent) | PAID | FAILED (see error; Retry in Admin)
  stripeTransferId String?
  error            String?
  createdAt        DateTime  @default(now())
  claimedAt        DateTime? // when the monthly run or a Retry last started sending it ("stuck" is measured from here)
  paidAt           DateTime?

  mentor   User   @relation("MentorPayouts", fields: [mentorId], references: [id])
  mentorId String

  hourEntries HourEntry[]
  orders      Order[]

  @@unique([mentorId, period])
  @@index([period, status])
  @@index([status, createdAt])
}

// One row each time the mentor marks the work complete. A revision
// request sends the order back to the mentor, and the next "Mark work as
// complete" adds Delivery 2, 3... Older deliveries are never deleted, so
// the student (and an admin, in a dispute) can see the whole history.
model Delivery {
  id          String   @id @default(cuid())
  number      Int // 1, 2, 3... per order
  description String
  // [{ url, name }] - url is the private storage path (lib/storage.ts), or an old Vercel Blob address.
  files       Json     @default("[]")
  createdAt   DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  @@unique([orderId, number])
}

// A separate thread from the regular buyer/seller Conversation, created
// implicitly the moment a dispute is opened. Buyer, seller, and any admin
// can all post here - this is specifically where an admin asks follow-up
// questions to understand what happened before deciding to refund or
// release. Kept distinct from the regular message thread so there's a
// clean, dedicated record of the dispute itself.
model DisputeMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  @@index([orderId, createdAt])
}

// One row per call booked on an order. Since Phase 3 every call is booked
// on MentorsMD itself (the student picks a slot from the mentor's
// availability) and happens in a private Daily room. Old rows from Cal.com
// keep source "CAL".
model CallBooking {
  id             String     @id @default(cuid())
  startTime      DateTime
  endTime        DateTime
  status         CallStatus @default(BOOKED)
  source         String     @default("SITE") // SITE (built-in calendar), MANUAL (mentor added), CAL (old)
  calUid         String?    @unique // old Cal.com booking uid
  meetingUrl     String? // old Cal.com video link (no longer used)
  reminderSentAt DateTime? // old, unused
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Daily room for this call (private; people join with a meeting token).
  roomName                 String?
  roomUrl                  String?
  // When the time was last set (booked or rescheduled), and by whom.
  scheduledAt              DateTime?
  bookedById               String?
  cancelledAt              DateTime?
  cancelledById            String?
  // Bumped on every reschedule, so calendar apps replace the old invite.
  icsSequence              Int       @default(0)
  // Reminders: each is sent once. A reschedule clears them.
  morningReminderStudentAt DateTime?
  morningReminderMentorAt  DateTime?
  hourReminderAt           DateTime?
  // What happened at the call, decided from Daily's attendance about 30
  // minutes after the end (lib/callOutcomes.ts), or set by an admin:
  // HELD | STUDENT_NO_SHOW | MENTOR_NO_SHOW | NOBODY_JOINED | UNCLEAR | FREE_REBOOK.
  // Null = not decided yet. outcomeById null = decided automatically.
  outcome                  String?
  outcomeAt                DateTime?
  outcomeById              String?

  // ORDER = a call on an order (uses its hours); INTRO = the free
  // 15-minute intro call (redesign Oct 2026): no order, no payment, never
  // counts as hours, one per student and mentor (introKey).
  kind      String  @default("ORDER")
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId   String?
  // Who the call is between. Always set for INTRO calls (there's no
  // order to read them from); new ORDER calls set them too.
  student   User?   @relation("IntroCallStudent", fields: [studentId], references: [id])
  studentId String?
  mentor    User?   @relation("IntroCallMentor", fields: [mentorId], references: [id])
  mentorId  String?
  // "<studentId>:<mentorId>" on an INTRO call while it counts (cleared
  // when it's cancelled, so they can book again). Unique: one per pair.
  introKey  String? @unique

  attendance CallAttendance[]
  recordings CallRecording[]
  hourEntry  HourEntry?

  @@index([orderId, startTime])
  @@index([mentorId, status, startTime])
  @@index([studentId, status, startTime])
  @@index([status, startTime])
  @@index([roomName])
}

// Who joined a call and when (from Daily's webhooks).
model CallAttendance {
  id          String    @id @default(cuid())
  sessionId   String    @unique // Daily's participant session id
  name        String?
  joinedAt    DateTime
  leftAt      DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())

  booking   CallBooking @relation(fields: [bookingId], references: [id])
  bookingId String
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?

  @@index([bookingId, joinedAt])
}

// Cloud recordings of a call (admin-only). The video itself stays on
// Daily; we keep its id and delete it 60 days after the order closes.
model CallRecording {
  id               String    @id @default(cuid())
  dailyRecordingId String    @unique
  status           String?
  startedAt        DateTime?
  durationSec      Int?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  booking   CallBooking @relation(fields: [bookingId], references: [id])
  bookingId String

  @@index([deletedAt, createdAt])
}

// A mentor's busy dates (exams, rotations, travel). The note is private.
// NO_DEADLINES: students can't pick a due date in the range.
// NO_DEADLINES_NO_CALLS: no due dates and no calls in the range.
// Days are calendar dates ("YYYY-MM-DD"), both ends included.
model BusyDate {
  id        String   @id @default(cuid())
  startDay  String
  endDay    String
  kind      String   @default("NO_DEADLINES")
  note      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, startDay])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique // one review per order, enforced at the database level

  buyer    User   @relation("ReviewsByBuyer", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("ReviewsOfSeller", fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  buyer    User   @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId  String
  seller   User   @relation("SellerConversations", fields: [sellerId], references: [id])
  sellerId String

  // Last time each side was emailed about new messages here - used to
  // send at most one notification email per 15 minutes per conversation.
  buyerNotifiedAt  DateTime?
  sellerNotifiedAt DateTime?

  // Unread message counts for each side. Sending a message adds one to
  // the other person's count; opening the conversation resets yours.
  buyerUnread  Int @default(0)
  sellerUnread Int @default(0)

  messages Message[]
  orders   Order[]

  @@unique([buyerId, sellerId])
  @@index([sellerId, createdAt])
  @@index([buyerId, buyerUnread])
  @@index([sellerId, sellerUnread])
}

model Message {
  id             String   @id @default(cuid())
  body           String
  attachmentUrl  String? // private storage path of an attached file (lib/storage.ts); old rows hold a Vercel Blob address
  attachmentName String? // original filename, shown in the UI
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  // The order (package) this message and its attachment belong to; null =
  // a general message, e.g. before anything was bought (redesign Oct 2026).
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId])
  @@index([orderId, createdAt])
}

// Someone applying to mentor via /become-a-mentor/apply. An admin reviews
// it in Admin -> Applications and either invites them (the normal invite
// flow) or declines.
model MentorApplication {
  id            String            @id @default(cuid())
  name          String
  email         String
  phone         String
  medicalSchool String
  residency     String?
  blurb         String
  resumeUrl     String // private storage path (lib/storage.ts); old rows hold a Vercel Blob address
  resumeName    String
  status        ApplicationStatus @default(PENDING)
  // SHA-256 of the sender's IP (never the IP itself), for the simple
  // "too many applications from here" limit.
  ipHash        String?
  createdAt     DateTime          @default(now())
  decidedAt     DateTime?
  inviteId      String?
  // Leads inbox: the team member looking after it, and internal notes.
  assignedToId  String?
  assignedTo    User?             @relation("ApplicationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes         LeadNote[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------- Safety and integrity (Phase 4) ----------------

// "Confirm your email" links. Only a SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// Fallback rate-limit counters, used only when Upstash Redis isn't set
// up. One row per (limit, person or IP, time window); old rows are
// cleaned up by the daily safety cron.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// One item in Admin -> Flags: a student/mentor report, a dispute, or an
// automatic flag (word filter, off-site contact, ghostwriting, links, AI
// check, performance). Severity: 1 low, 2 medium, 3 high.
// Status: OPEN, DISMISSED, UPHELD (an admin warned, paused or removed).
model Flag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String // REPORT, DISPUTE, LANGUAGE, OFF_SITE, GHOSTWRITING, CREDENTIALS, LINK, AI, PERFORMANCE, BLOCKED_MESSAGE, MINOR, CALL
  source    String   @default("AUTO") // USER, AUTO, AI, CRON, SYSTEM
  severity  Int      @default(1)
  status    String   @default("OPEN")
  reason    String // short title, e.g. "Asked to pay outside MentorsMD"
  details   String? // longer explanation / the reporter's words
  evidence  String? // the text that triggered it (message excerpt)
  matches   String[] @default([]) // words/phrases to highlight in the evidence
  dedupeKey String? // stops the daily checks raising the same flag again

  subject       User?   @relation("FlagsAbout", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectUserId String?
  reporter      User?   @relation("FlagsReported", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId    String?

  conversationId String?
  messageId      String?
  orderId        String?
  gigId          String?

  action         String? // DISMISS, WARN, PAUSE, REMOVE, REFUND, RELEASE, AUTO_PAUSE
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedBy     User?     @relation("FlagsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById   String?
  emailedAt      DateTime? // high-severity alert sent to admins

  @@index([status, severity, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([dedupeKey, createdAt])
  @@index([orderId])
  @@index([conversationId, createdAt])
}

// Someone blocked someone: neither can message the other.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Admin action log: who did what, to whom, when.
model AdminAction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String // e.g. FLAG_DISMISS, USER_PAUSE, ORDER_REFUND, INVITE_SENT
  targetType String? // USER, ORDER, FLAG, INVITE, APPLICATION
  targetId   String?
  summary    String
  details    Json?

  admin        User?   @relation("AdminActionsBy", fields: [adminId], references: [id], onDelete: SetNull)
  adminId      String? // null = done automatically by the system
  targetUser   User?   @relation("AdminActionsAbout", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserId String?

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

// ---------------- Legal, minors and admin team (Phase 5) ----------------

// A version of one legal document, edited in Admin -> Legal. Drafts have
// no version number; publishing gives the next number (1, 2, 3...).
// changeType MAJOR = everyone must accept it again (blocking screen);
// MINOR = small fix, earlier acceptances still count. Version 1 is always
// treated as MAJOR: publishing it switches the requirement on.
model LegalDocument {
  id          String    @id @default(cuid())
  kind        String // TERMS, PRIVACY, MENTOR_AGREEMENT, COMMUNITY_GUIDELINES, PARENTAL_CONSENT
  version     Int?
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  title       String
  body        String
  changeType  String    @default("MAJOR") // MAJOR, MINOR
  changeNote  String? // "What changed", shown on the blocking screen
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  publishedAt DateTime?

  createdBy     User?   @relation("LegalDocsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?
  publishedById String?

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, status, publishedAt])
}

// One row each time someone accepts a legal document (or a parent signs
// the parental consent form): which version, when, from which IP and
// browser. version 0 = the built-in text, before any version was published.
model LegalAcceptance {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  version    Int
  context    String // SIGNUP, GOOGLE_SIGNUP, PROMPT, MENTOR_JOIN, PARENT_CONSENT
  email      String // the account's email at the time (the parent's, for PARENT_CONSENT)
  signerName String? // typed signature (parent consent)
  ip         String?
  userAgent  String?

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  document   LegalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  @@index([userId, kind, version])
  @@index([kind, version, createdAt])
  @@index([createdAt])
}

// Consent from a parent or guardian for a student aged 13-17. The link
// emailed to the parent works for 7 days (only its hash is stored;
// reminders send a fresh link with the same expiry). viewToken is the
// parent's private link to order and call history.
model ParentConsent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  status             String    @default("PENDING") // PENDING, CONSENTED, DECLINED, EXPIRED, WITHDRAWN, REPLACED
  parentName         String
  parentEmail        String
  parentPhone        String
  tokenHash          String    @unique
  expiresAt          DateTime
  lastSentAt         DateTime?
  remindersSent      Int       @default(0)
  consentedAt        DateTime?
  signatureName      String?
  ip                 String?
  userAgent          String?
  termsVersion       Int?
  consentFormVersion Int?
  viewToken          String?   @unique
  withdrawnAt        DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Admin -> Team invites. The invitee opens the emailed link, picks a name
// and password, and becomes an admin. Only the hash of the link is stored.
model AdminInvite {
  id              String           @id @default(cuid())
  email           String
  adminRole       String           @default("ADMIN") // OWNER or ADMIN
  // Custom role the new member gets (null = full Admin or Owner).
  adminCustomRole AdminCustomRole? @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  adminRoleId     String?
  tokenHash       String           @unique
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  acceptedUserId  String?

  invitedBy   User?   @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?

  @@index([createdAt])
}

// Custom admin roles (Admin -> Team -> Roles): a name and the admin areas
// it can open (keys from lib/adminPermissions.ts). Only Owners manage them;
// a role that someone (or an open invite) uses can't be deleted.
model AdminCustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]
  invites AdminInvite[]
}

// A phone signed in to the MentorsMD app (lib/appAuth.ts). The app keeps a
// refresh token (only its hash is stored here) and trades it for
// 15-minute access tokens. Ended by signing out in the app, "Sign out" on
// the device in Settings, "Sign out of other devices", a password change,
// an admin removing the account, or 30 days without use (1 hour for
// admins, as on the website).
model AppSession {
  id          String    @id @default(cuid())
  refreshHash String    @unique
  platform    String // IOS or ANDROID
  deviceName  String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, revokedAt])
}

// Admin 2-step verification: emailed codes (EMAIL_CODE) and the one-time
// ticket that upgrades a login once the code is right (SESSION).
model AdminMfaToken {
  id        String    @id @default(cuid())
  kind      String // EMAIL_CODE, SESSION
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, kind, createdAt])
}

// ---------------- Insights (Phase 6) ----------------

// The private activity log behind Admin -> Insights (#86): site visits,
// mentor profile views and browse searches. Only admins ever see it.
// visitorId is a random id kept in a first-party cookie (never an IP).
// kind: VISIT, PROFILE_VIEW, SEARCH, SIGNUP
model ActivityEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  kind        String
  visitorId   String?
  mentorId    String? // PROFILE_VIEW: whose profile
  query       String? // SEARCH: the typed words (lowercased)
  filters     Json? // SEARCH: { service: [...], school: [...], ... }
  resultCount Int? // SEARCH: how many mentors matched
  source      String? // VISIT / SIGNUP: where the visitor came from
  path        String? // VISIT: landing page

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([kind, createdAt])
  @@index([mentorId, kind, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

// Admin -> Website: editable text and photos for the public pages. One row
// per page; draft/live hold only the fields that differ from the built-in
// defaults in lib/siteContent.ts. draft null = no unpublished changes.
// (prisma/website-editor-2026-10.sql)
model SiteContent {
  key           String    @id
  draft         Json?
  live          Json?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   String?
  publishedAt   DateTime?
  publishedById String?
}

// ---------------- Emails (Oct 2026) ----------------

// Admin -> Emails: the wording an admin saved for one automatic email.
// key matches an entry in lib/emailTemplates.ts. No row = the default
// wording in that file is used. updatedById is the admin who saved it
// (kept as a plain id so this table doesn't change the User model).
model EmailTemplate {
  key         String   @id
  subject     String
  body        String
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
}

// Admin -> Emails -> a reminder email (lib/scheduledEmails.ts): whether
// it's switched on and its timing, e.g. "After 1 day, then 3 days". No
// row = off, with the standard timing from lib/emailTemplates.ts.
model EmailSchedule {
  key         String   @id
  enabled     Boolean  @default(false)
  timing      String
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
}

// One row per reminder email sent by the daily cron (lib/scheduledEmails.ts),
// so the same step is never sent twice. refId is what the reminder is
// about: the checkout (order or top-up id), the intro call, or the
// person's own id. aboutId is the mentor it mentions, if any. Plain ids,
// so this table doesn't change the User model.
model ScheduledEmailSent {
  id      String   @id @default(cuid())
  key     String
  refId   String
  step    Int // 0 = the first email, 1 = the second...
  userId  String
  aboutId String?
  toEmail String
  sentAt  DateTime @default(now())

  @@unique([key, refId, step])
  @@index([key, sentAt])
  @@index([userId, key])
}

// Admin -> Email log: one row per send attempt from lib/email.ts (never
// the email body). status: SENT or FAILED. Rows older than 90 days are
// deleted by the daily safety cron.
model EmailLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  templateKey String
  toEmail     String
  subject     String
  status      String
  providerId  String?
  error       String?

  @@index([createdAt])
  @@index([templateKey, createdAt])
  @@index([toEmail, createdAt])
}

// ---------------- Leads inbox (Oct 2026) ----------------

// Waitlist signups ("Tell me when mentors join") and contact-form
// messages. Mentor applications stay in MentorApplication; Admin -> Leads
// shows all three. See lib/leads.ts.
model Lead {
  id           String     @id @default(cuid())
  kind         String // WAITLIST | CONTACT
  // "waitlist:<email>" for waitlist signups (one per email); null for
  // contact messages, which can repeat.
  dedupeKey    String?    @unique
  email        String
  name         String?
  topic        String? // contact: STUDENT | MENTOR | PARENT | PRESS | OTHER
  message      String?
  service      String? // waitlist: what they need help with (lib/options.ts SERVICES)
  applyYear    String? // waitlist: the year they plan to apply
  source       String? // waitlist: the page they signed up on
  status       String     @default("NEW") // NEW | IN_PROGRESS | DONE
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Waitlist: when the "Mentors are now available" email went out.
  notifiedAt   DateTime?
  ipHash       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  notes        LeadNote[]

  @@index([kind, status, createdAt])
  @@index([kind, notifiedAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// Internal notes on a lead or a mentor application (never shown to them).
model LeadNote {
  id            String             @id @default(cuid())
  leadId        String?
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  applicationId String?
  application   MentorApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  authorId      String?
  author        User?              @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([leadId, createdAt])
  @@index([applicationId, createdAt])
}

// ---- Gifts from a parent (lib/gifts.ts) ----
// A parent or guardian (no account) pays on /gift for their student:
// MentorsMD credit (kind CREDIT) or one of a mentor's offers (PACKAGE).
// Paid by Stripe Checkout as a guest. When the payment clears, the
// student's account is found by email or created without a password, and
// the credit (a CreditEntry, reason GIFT) or the order (a normal Order,
// as if the student bought it) is added to it. The parent gets a private
// page at /gift/<token>. Student, mentor, order and credit entry are kept
// as plain ids so this table doesn't change the other models.
model Gift {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  kind                  String // CREDIT | PACKAGE
  // PENDING (on the Stripe page), PAID, CANCELLED (page expired),
  // NEEDS_REVIEW (paid, but couldn't be given: see reviewNote)
  status                String    @default("PENDING")
  amountCents           Int
  parentName            String
  parentEmail           String
  studentName           String
  studentEmail          String
  note                  String? // the parent's personal note to the student
  studentUnder18        Boolean   @default(false) // the parent's answer on the form
  // PACKAGE: the offer bought and what it was when they paid.
  gigId                 String?
  mentorId              String?
  minutes               Int?
  rateCents             Int?
  packageTitle          String?
  // What the gift became once paid.
  studentId             String?
  orderId               String?   @unique
  creditEntryId         String?   @unique
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  reviewNote            String?
  // The parent's private page (sha256 of the token in the link).
  viewTokenHash         String    @unique
  // "Claim your gift": a new student account sets its password with this
  // link (sha256 of the token). Null when the student already had an account.
  claimTokenHash        String?   @unique
  claimExpiresAt        DateTime?
  claimedAt             DateTime?
  ip                    String? // salted hash of the IP (lib/request.ts ipKey)

  @@index([status, createdAt])
  @@index([studentId])
  @@index([parentEmail, createdAt])
}

// ---- Cycle results (lib/cycleResults.ts) ----
// A student's application outcomes, one row per school per cycle. Behind
// the NEXT_PUBLIC_CYCLE_RESULTS switch (off by default) and not shown
// anywhere public yet. Student and mentors are plain ids so this table
// doesn't change the User model.
model CycleResult {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  cycle       Int // the year they'd start medical school, e.g. 2027
  school      String
  // APPLIED, SECONDARY, INTERVIEW_INVITE, INTERVIEWED, WAITLISTED,
  // ACCEPTED, REJECTED, WITHDRAWN, MATRICULATING
  status      String
  appliedOn   DateTime? @db.Date
  interviewOn DateTime? @db.Date
  decisionOn  DateTime? @db.Date
  mentorIds   String[]  @default([]) // MentorsMD mentors who helped
  note        String?

  @@unique([userId, cycle, school])
  @@index([cycle, status])
}

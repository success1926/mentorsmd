{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SITE_URL": "https://REPLACE-WITH-A-PREVIEW-URL.vercel.app" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SITE_URL": "https://REPLACE-WITH-A-PREVIEW-URL.vercel.app" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SITE_URL": "https://www.mentorsmd.com" }
    },
    "simulator": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": { "simulator": true }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6838765508" }
    }
  }
}

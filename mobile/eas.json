{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SITE_URL": "https://REPLACE-WITH-A-PREVIEW-URL.vercel.app" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SITE_URL": "https://REPLACE-WITH-A-PREVIEW-URL.vercel.app" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SITE_URL": "https://www.mentorsmd.com" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE-AFTER-CREATING-THE-APP-IN-APP-STORE-CONNECT" }
    }
  }
}

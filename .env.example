# Postgres connection strings. Easiest options: Railway, Supabase, or Neon (all have free tiers).
# DATABASE_URL = the POOLED connection string (Neon: the host containing "-pooler").
#   Needed in production on Vercel so traffic spikes don't exhaust database connections.
# DIRECT_URL   = the normal (non-pooled) string. Only used by `prisma migrate`.
# For local development it's fine to set both to the same value.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# The site's own address, used for logins and for links in emails, Stripe and invites
# (lib/siteUrl.ts). Set it for Production only: Vercel previews leave it unset and use
# their own address automatically.
NEXTAUTH_URL="http://localhost:3000"

# From your Stripe dashboard (use test mode keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the webhook's settings page in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# From https://dashboard.daily.co (free tier is enough to start). Without it, calls can still be
# booked but the Join button says video isn't set up.
DAILY_API_KEY="your-daily-api-key"

# From https://resend.com - used to auto-email seller invite links
RESEND_API_KEY="re_..."
INVITE_EMAIL_FROM="onboarding@yourdomain.com"

# ---- Supabase: file storage and live messages (replaced Vercel Blob and Pusher, Oct 2026) ----
# Supabase dashboard -> the MentorsMD project. Set the same values for Production AND Preview
# (previews keep their files and live updates apart under "preview/" automatically).
# Project Settings -> API keys: the project URL and the anon (or "publishable") key. Both are public.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# Project Settings -> API keys: the service_role (or "secret") key. SERVER ONLY, never NEXT_PUBLIC_.
# Creates upload/download links and sends live updates.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Project Settings -> JWT Keys -> Legacy JWT secret. SERVER ONLY. Signs the one-hour live-update passes.
SUPABASE_JWT_SECRET="your-legacy-jwt-secret"

# From https://console.cloud.google.com (see README for the click-by-click setup)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Generate with: openssl rand -base64 32
# Protects the /api/cron/* routes so only Vercel's scheduler can trigger them.
CRON_SECRET="replace-with-a-random-string"

# ---- Added in the Sept 2026 redesign ----
# Shown on /contact. The phone card only appears if a number is set.
NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.com"
NEXT_PUBLIC_CONTACT_PHONE=""

# ---- Added in Phase 2 (Oct 2026) ----
# Where mentor applications from /become-a-mentor/apply are emailed (resume attached, reply-to the applicant).
APPLICATIONS_EMAIL="success@mentorsmd.com"

# ---- Added in Phase 3 (Oct 2026): built-in calendar and video calls ----
# "true" records every call to Daily's cloud automatically (needs a paid Daily plan). Leave empty to turn recording off.
DAILY_RECORDING_ENABLED=""
# Secret from Admin -> Calls & recordings -> "Connect Daily webhook"; checks attendance/recording events really come from Daily.
DAILY_WEBHOOK_SECRET=""

# ---- Added in Phase 4 (Oct 2026): safety and integrity ----
# Google reCAPTCHA v3 keys (https://www.google.com/recaptcha/admin, type "Score based (v3)"). The site key is public; leave both empty to skip the check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Optional alias for the site key above (either name works).
RECAPTCHA_SITE_KEY=""
# reCAPTCHA v3 secret key (server only).
RECAPTCHA_SECRET_KEY=""
# Upstash Redis REST URL and token (https://console.upstash.com) for rate limits; empty = limits are counted in the database instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Anthropic API key (https://console.anthropic.com) for the AI message check; empty = only the word filter runs.
ANTHROPIC_API_KEY=""
# Google Safe Browsing API key (Google Cloud console -> enable "Safe Browsing API"); empty = links aren't checked against Google's unsafe-site list.
GOOGLE_SAFE_BROWSING_KEY=""
# Sentry DSN (https://sentry.io -> project -> Client Keys) for error alerts; empty = errors only go to the Vercel logs.
SENTRY_DSN=""
# Optional label for Sentry events (defaults to the Vercel environment, e.g. "production" or "preview").
SENTRY_ENVIRONMENT=""

# ---- Added Oct 2026: one-click "Connect Google Calendar" for mentors ----
# Uses the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as Google sign-in.
# Key that encrypts the Google Calendar permission stored for each mentor. Generate with: openssl rand -base64 32
# Optional: if empty, a key is derived from NEXTAUTH_SECRET. Changing it later means mentors must reconnect.
GOOGLE_CALENDAR_TOKEN_KEY=""

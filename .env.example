# Postgres connection string. Easiest options: Railway, Supabase, or Neon (all have free tiers).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# From your Stripe dashboard (use test mode keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the webhook's settings page in production
STRIPE_WEBHOOK_SECRET="whsec_..."

# From https://dashboard.daily.co (free tier is enough to start)
DAILY_API_KEY="your-daily-api-key"

# From https://resend.com - used to auto-email seller invite links
RESEND_API_KEY="re_..."
INVITE_EMAIL_FROM="onboarding@yourdomain.com"

# From https://dashboard.pusher.com (Channels product, free tier is enough to start)
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-key"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="us2"
# Same key/cluster values, exposed to the browser (NEXT_PUBLIC_ vars are safe to expose - the secret above never is)
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# From https://console.cloud.google.com (see README for the click-by-click setup)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# From https://business.trustpilot.com - see README for setup steps
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID="your-business-unit-id"
NEXT_PUBLIC_TRUSTPILOT_REVIEW_URL="https://www.trustpilot.com/review/yourdomain.com"

# From your Vercel project's Storage tab -> create a Blob store (free tier is enough to start).
# Used for file attachments in messages.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Generate with: openssl rand -base64 32
# Protects the /api/cron/* routes so only Vercel's scheduler can trigger them.
CRON_SECRET="replace-with-a-random-string"
